# ============================================================================
# .htaccess — Papan Kendali Gudang
#
# Berlaku untuk XAMPP (Apache lokal) maupun Hostinger.
# Blok HTTPS sengaja dilewati di localhost supaya pengembangan tidak terganggu.
# ============================================================================

# --- Paksa HTTPS, KECUALI di localhost -------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Blokir akses langsung ke folder & berkas sensitif ----------------------
RedirectMatch 404 ^/.*/(config|includes|sql|tools)/.*$
RedirectMatch 404 ^/(config|includes|sql|tools)/.*$

<FilesMatch "\.(sql|md|log|ini|json|lock)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Prototipe lama — jangan pernah tersaji di produksi.
<FilesMatch "^aplikasi-gudang.*\.html$">
    Require all denied
</FilesMatch>

# --- Matikan daftar isi direktori -------------------------------------------
Options -Indexes

# --- Header keamanan --------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
</IfModule>

# --- Kompresi ---------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json
</IfModule>

# --- Cache aset statis ------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresDefault                        "access plus 1 hour"
</IfModule>

# --- Halaman awal -----------------------------------------------------------
DirectoryIndex index.php
